diff --git a/docker/Dockerfile.base b/docker/Dockerfile.base
index 7bdb0403..c9a2a709 100644
--- a/docker/Dockerfile.base
+++ b/docker/Dockerfile.base
@@ -94,6 +94,47 @@ RUN echo "export ISAACLAB_PATH=${ISAACLAB_PATH}" >> ${HOME}/.bashrc && \
     echo "alias tensorboard='${ISAACLAB_PATH}/_isaac_sim/python.sh ${ISAACLAB_PATH}/_isaac_sim/tensorboard'" >> ${HOME}/.bashrc && \
     echo "export TZ=$(date +%Z)" >> ${HOME}/.bashrc
 
+
+
+# This overwrites the existing entrypoint that starts Isaac Sim.
+# ENTRYPOINT ["bash"]
+
+
+# create a new user and set the owner of the Isaac Lab directory to this user
+RUN useradd -ms /bin/bash isaac && \
+    chown -R isaac:isaac ${ISAACLAB_PATH} && \
+    echo "isaac    ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
+    chmod 0440 /etc/sudoers
+
+# switch to the new user
+# USER isaac
+
+
+# # Clear .bashrc
+# RUN > /root/.bashrc
+# # Clear .bash_profile (if it exists)
+# RUN > /root/.bash_profile
+# # Clear .bash_login (if it exists)
+# RUN > /root/.bash_login
+# # Clear .profile (for sh or dash shells)
+# RUN > /root/.profile
+
+# # You might also find these in /etc/
+# RUN > /etc/bash.bashrc
+# RUN > /etc/profile
+
+
+# RUN > /root/.bashrc \
+#     && > /root/.bash_profile \
+#     && > /root/.bash_login \
+#     && > /root/.profile \
+#     && > /etc/bash.bashrc \
+#     && > /etc/profile
+
+# RUN echo ":" > /isaac-sim/runheadless.native.sh
+
+
 # make working directory as the Isaac Lab directory
 # this is the default directory when the container is run
 WORKDIR ${ISAACLAB_PATH}
+
