+def find_seed_metrics(run_path):
+    """Find all metrics.yaml files for a given run_path with SEED_* suffix."""
+    base_dir = os.path.dirname(run_path)
+    run_name = os.path.basename(run_path)
+    pattern = os.path.join(base_dir, f"{run_name}_SEED_*/metrics.yaml")
+    return sorted(glob.glob(pattern))
+
+def compute_mean_and_range(metric_dicts):
+    """Compute mean and range for each metric."""
+    aggregated = defaultdict(list)
+    for name, data in metric_dicts:
+        for k, v in data.items():
+            aggregated[k].append(v)
+    
+    stats = {}
+    for k, values in aggregated.items():
+        arr = np.array(values)
+        stats[k] = {
+            "mean": np.mean(arr),
+            "min": np.min(arr),
+            "max": np.max(arr),
+            "range": (np.min(arr), np.max(arr)),
+        }
+    return stats
+
